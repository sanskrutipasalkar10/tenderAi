# Database
DATABASE_URL=postgresql://tender:tender@localhost:5432/tender_platform

# Object storage (MinIO locally, S3-compatible in prod)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=tenders

# AI providers — Gemini (Vertex AI Express Mode) is primary for all 3 tasks
# (map/reduce/vision), docs/DECISIONS.md #76. Get a key from
# https://aistudio.google.com/ (or your team's Vertex Express key — note the "AQ."
# prefix on an Express key means it must be a Vertex Express key, not a plain
# AI-Studio key; app/llm/client.py's Gemini path is written specifically for Express
# Mode's endpoint/payload shape). Required for real analysis to run.
GEMINI_API_KEY=
# Ollama (cloud or a genuinely local model via a local `ollama serve` daemon) is the
# automatic fallback if every Gemini call fails — `ollama` must be installed; `ollama
# list` shows available models. Not required to have this working for a first-time
# setup, but every real document run will silently have no fallback until it does.
USE_LOCAL_VISION=false          # true to route vision calls to a genuinely local model instead (offline/air-gapped work, no Gemini attempted)
OLLAMA_BASE_URL=http://localhost:11434

# Queue / cache
REDIS_URL=redis://localhost:6379/0

# Auth — a single shared credential (docs/DECISIONS.md #44), not a per-user login.
# Generate AUTH_PASSWORD_HASH with:
#   python -c "from app.core.security import hash_password as h; print(h('your-password'))"
JWT_SECRET_KEY=change-me-in-every-environment
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=change-me-in-every-environment
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Tracing — self-hosted (docs/DECISIONS.md #52), not Langfuse Cloud: traces carry real
# prompt content (real tender text), asked of and confirmed by the user to stay local.
# `docker-compose up langfuse` brings up the service at LANGFUSE_HOST; sign up there
# (it's your own local instance) and create a project to get these two keys. Tracing
# is a no-op (app/core/tracing.py) until both are set — safe to leave blank in dev.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# Review-evidence email notifications (docs/DECISIONS.md) — sent when a bid-team
# member marks a Go/No-Go criterion eligible during human review, flagging the gap
# for manual entry into the company profile. app/core/email.py no-ops cleanly (logs,
# never blocks the review) until SMTP_HOST/SMTP_USERNAME are both set — safe to leave
# blank in dev. For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME is
# the sending Gmail address, SMTP_PASSWORD is a 16-character Google "App Password"
# (Google Account -> Security -> App Passwords), NOT the normal account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
REVIEW_NOTIFICATION_EMAIL=sanskruti.pasalkar@c4i4.org

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_UPLOAD_PAGES=2000
MAX_UPLOAD_SIZE_MB=500

# CORS — comma-separated origins allowed to call this API from a browser (the Next.js
# frontend's dev server by default). Add the real deployed frontend origin here too
# once there is one.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Hyperlinked-document fetching (docs/DECISIONS.md #75) — GeM tender cover sheets
# link out to the real tender content instead of embedding it (e.g. "...AS PER
# ANNEXURE A ENCLOSED" is a clickable URI, not an attachment). A URL pulled from an
# uploaded PDF is only ever fetched if its host matches one of these comma-separated
# suffixes (app/guardrails/link_checks.py) — this is a security gate, not a feature
# flag; broadening it means trusting a new external host to receive server-side
# fetches triggered by untrusted uploaded content.
LINKED_DOC_ALLOWED_HOST_SUFFIXES=gem.gov.in
LINKED_DOC_MAX_PER_DOCUMENT=20
LINKED_DOC_FETCH_TIMEOUT_SECONDS=30
