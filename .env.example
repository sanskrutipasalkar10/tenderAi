# Database
DATABASE_URL=postgresql://tender:tender@localhost:5432/tender_platform

# Object storage (MinIO locally, S3-compatible in prod)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=tenders

# AI providers — Ollama Cloud (free tier on this account, docs/DECISIONS.md #28),
# reached through a local Ollama daemon (`ollama` must be installed and logged in;
# `ollama list` shows your account's available cloud models). No separate API key.
USE_LOCAL_VISION=false          # true to route vision calls to a genuinely local model instead
OLLAMA_BASE_URL=http://localhost:11434

# Queue / cache
REDIS_URL=redis://localhost:6379/0

# Auth — a single shared credential (docs/DECISIONS.md #44), not a per-user login.
# Generate AUTH_PASSWORD_HASH with:
#   python -c "from app.core.security import hash_password as h; print(h('your-password'))"
JWT_SECRET_KEY=change-me-in-every-environment
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=change-me-in-every-environment
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Tracing — self-hosted (docs/DECISIONS.md #52), not Langfuse Cloud: traces carry real
# prompt content (real tender text), asked of and confirmed by the user to stay local.
# `docker-compose up langfuse` brings up the service at LANGFUSE_HOST; sign up there
# (it's your own local instance) and create a project to get these two keys. Tracing
# is a no-op (app/core/tracing.py) until both are set — safe to leave blank in dev.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_UPLOAD_PAGES=2000
MAX_UPLOAD_SIZE_MB=500
